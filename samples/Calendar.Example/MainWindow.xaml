<Window
    x:Class="Calendar.Example.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="using:Calendar.WinUI.Controls"
    Title="Calendar Example">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="Root"
        Padding="24"
        RowSpacing="16">
        <Grid.Resources>
            <DataTemplate x:Key="CustomEventTemplate">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{Binding Label}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        MinWidth="20"
                        MinHeight="20"
                        Padding="4,0"
                        AutomationProperties.AutomationId="{Binding ActionAutomationId}"
                        AutomationProperties.Name="{Binding Label}"
                        Click="TemplateAction_Click"
                        Content="⋯" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    x:Name="MonthTitle"
                    AutomationProperties.AutomationId="MonthTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="NoWrap" />
                <TextBlock x:Name="Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.AutomationId="PreviousMonth"
                    Click="Previous_Click"
                    Content="이전" />
                <Button
                    x:Name="TodayButton"
                    AutomationProperties.AutomationId="TodayMonth"
                    Click="Today_Click"
                    Content="오늘" />
                <Button
                    x:Name="NextButton"
                    AutomationProperties.AutomationId="NextMonth"
                    Click="Next_Click"
                    Content="다음" />
            </StackPanel>
        </Grid>
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="AddButton"
                AutomationProperties.AutomationId="AddEvent"
                Click="Add_Click"
                Content="이벤트 추가" />
            <Button
                x:Name="ResetButton"
                AutomationProperties.AutomationId="ResetEvents"
                Click="Reset_Click"
                Content="초기화" />
            <ToggleSwitch
                x:Name="CustomTemplateToggle"
                AutomationProperties.AutomationId="CustomTemplate"
                Header="사용자 템플릿"
                Toggled="Template_Toggled" />
            <ToggleSwitch
                x:Name="DarkToggle"
                AutomationProperties.AutomationId="DarkTheme"
                Header="어두운 테마"
                Toggled="Theme_Toggled" />
            <ToggleSwitch
                x:Name="SelectionToggle"
                AutomationProperties.AutomationId="DateSelection"
                Header="날짜 선택"
                IsOn="True"
                Toggled="Selection_Toggled" />
            <ToggleSwitch
                x:Name="EventSelectionToggle"
                MinWidth="110"
                AutomationProperties.AutomationId="EventSelection"
                Header="이벤트 선택"
                IsOn="True"
                Toggled="EventSelection_Toggled" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="TimeZonePicker" Width="240" Header="UTC 시간대" AutomationProperties.AutomationId="DisplayTimeZone" SelectionChanged="TimeZone_Changed" />
            <ComboBox x:Name="LanguagePicker" Width="180" Header="언어" AutomationProperties.AutomationId="DisplayLanguage" SelectionChanged="Language_Changed">
                <ComboBoxItem Tag="" Content="시스템" AutomationProperties.AutomationId="LanguageSystem" />
                <ComboBoxItem Tag="ko-KR" Content="한국어" AutomationProperties.AutomationId="LanguageKorean" />
                <ComboBoxItem Tag="en-US" Content="English" AutomationProperties.AutomationId="LanguageEnglish" />
            </ComboBox>
            <ToggleSwitch
                x:Name="EventInvocationToggle"
                MinWidth="110"
                AutomationProperties.AutomationId="EventInvocation"
                Header="Event invocation"
                IsOn="True"
                Toggled="EventInvocation_Toggled" />
        </StackPanel>
        <calendar:Calendar
            x:Name="Board"
            Grid.Row="3"
            AutomationProperties.AutomationId="Calendar"
            DateInvoked="Date_Invoked"
            DisplayUnit="Month"
            EventInvoked="Event_Invoked"
            MoreInvoked="More_Invoked"
            SelectedDateChanged="DateSelection_Changed"
            SelectedEventChanged="EventSelection_Changed"
            VisibleRangeChanged="Range_Changed" />
        <StackPanel x:Name="StatusPanel" Grid.Row="4" Spacing="4">
            <TextBlock
                x:Name="Status"
                AutomationProperties.AutomationId="Status"
                Text="날짜, 이벤트 또는 더보기를 선택하세요."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="EventSelectionStatus"
                AutomationProperties.AutomationId="EventSelectionStatus"
                Text="Selected event: (none); changes=0" />
            <TextBlock x:Name="RangeStatus" AutomationProperties.AutomationId="RangeStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
